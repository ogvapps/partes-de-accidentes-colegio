rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Función de validación de dominio corporativo de Extremadura (@educarex.es)
    function isEducarex() {
      return request.auth != null && 
             request.auth.token.email != null &&
             request.auth.token.email.matches('.*@educarex\\.es$');
    }

    // Reglas para la colección de informes
    match /finishedReports/{reportId} {
      // Permitir crear informes solo si es cuenta corporativa y en estado 'pending'
      allow create: if isEducarex() 
                    && request.resource.data.status == 'pending';
      
      // Permitir lectura a usuarios autorizados del centro
      allow read: if isEducarex();
      
      // Permitir actualización a usuarios autorizados
      allow update: if isEducarex();
      
      // Permitir borrar solo a usuarios autorizados
      allow delete: if isEducarex();
    }
    
    // Denegar cualquier otro acceso por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
